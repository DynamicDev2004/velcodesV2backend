[Unit]
Description=Velcodes client portal
After=network.target
[Service]
Type=simple
User=velcodes
Group=velcodes
WorkingDirectory=/srv/velcodes/portal
EnvironmentFile=/srv/velcodes/portal/.env
ExecStart=/usr/bin/node /srv/velcodes/portal/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/velcodes/portal/data /srv/velcodes/portal/.local
UMask=0077
[Install]
WantedBy=multi-user.target
