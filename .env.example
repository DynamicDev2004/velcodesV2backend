NODE_ENV=development
HOST=127.0.0.1
PORT=4180
APP_ORIGIN=http://localhost:4180
DATABASE_PATH=./data/velcodes.sqlite
# Optional absolute path of your marketing website output. Defaults to ../dist.
SITE_DIRECTORY=../dist
ADMIN_EMAIL=info@velcodes.com
NOTIFICATION_EMAIL=info@velcodes.com
# Set to resend and supply a verified sender to enable email delivery.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=Velcodes <portal@velcodes.com>
# Use only behind a trusted proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
